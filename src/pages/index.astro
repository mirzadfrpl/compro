---
import BlankLayout from '../layouts/BlankLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const homepageData = await reader.singletons.homepage.read();
const servicesData = await reader.singletons.services.read();
const siteSettings = await reader.singletons.siteSettings.read();

const brandName = siteSettings?.brandName || 'Studio Ara';

const heroTitle = homepageData?.heroTitle || 'Structural <br/> Aesthetics';
const heroDescription = homepageData?.heroDescription || 'We build timeless identities and rigorous design systems for visionary global brands.';
const heroCarouselImages = homepageData?.heroCarouselImages?.length ? homepageData.heroCarouselImages : [
  'https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop'
];

const defaultLogos = [
  'https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg',
  'https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Google_2015_logo.svg/1280px-Google_2015_logo.svg.png',
  'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Microsoft_logo_%282012%29.svg/3840px-Microsoft_logo_%282012%29.svg.png',
  'https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/LinkedIn_icon.svg/3840px-LinkedIn_icon.svg.png',
  'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Gojek_logo_2019.svg/3840px-Gojek_logo_2019.svg.png'
];

const clientLogos = homepageData?.clientLogos?.length ? homepageData.clientLogos.map(c => c.logo) : defaultLogos;

const impactStats = homepageData?.impactStats?.length ? homepageData.impactStats : [
  { number: '12+', label: 'Years Active' },
  { number: '150', label: 'Global Projects' },
  { number: '24', label: 'Design Awards' },
  { number: '01', label: 'Singular Focus' }
];

const serviceList = servicesData?.serviceList?.length ? servicesData.serviceList : [
  { id: '01', title: 'Brand Identity', description: 'Developing rigorous and timeless visual systems that communicate authority and secure market positioning.' },
  { id: '02', title: 'Digital Spaces', description: 'Architecting immersive web experiences that merge structural typography with seamless user interaction.' },
  { id: '03', title: 'Creative Direction', description: 'Guiding overarching creative strategy and campaign design to ensure absolute brand consistency.' }
];

const ctaTitle = homepageData?.ctaTitle || 'Ready to Build?';
const ctaButtonText = homepageData?.ctaButtonText || 'Start a Conversation';
---

<BlankLayout>
  <!-- Hero Section -->
  <section class="relative w-full min-h-[85vh] flex flex-col md:flex-row items-center justify-center overflow-hidden border-b border-indigo/10 reveal-on-scroll animate-in">
    <!-- Geometric Background -->
    <div class="absolute inset-0 bg-paper -z-20">
      <div class="absolute inset-0 bg-[url('/assets/grid.svg')] bg-repeat opacity-40"></div>
    </div>
    
    <!-- Hero Content (Left) -->
    <div class="w-full md:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center z-10">
      <div class="w-8 h-8 bg-vermilion mb-8 reveal-on-scroll delay-100"></div>
      <h1 class="text-5xl md:text-6xl lg:text-8xl font-black uppercase tracking-tighter leading-[0.9] text-indigo mb-6 reveal-on-scroll delay-200" set:html={heroTitle}>
      </h1>
      <p class="text-lg md:text-xl font-medium text-indigo/80 max-w-md mb-10 leading-relaxed reveal-on-scroll delay-300">
        {heroDescription}
      </p>
      <div class="flex items-center gap-6 reveal-on-scroll delay-300">
        <a href="/works" class="px-8 py-4 bg-indigo text-paper text-sm font-bold uppercase tracking-widest hover:bg-vermilion transition-colors shadow-xl hover:shadow-vermilion/30">
          View Selected Works
        </a>
      </div>
    </div>

    <!-- Hero Visual (Right) -->
    <div class="w-full md:w-1/2 p-8 md:p-16 flex items-center justify-center relative reveal-on-scroll delay-200">
      <!-- Accent Box -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 aspect-square bg-gold/10 -z-10 rounded-full blur-3xl"></div>
      
      <!-- The Carousel (Card) -->
      <div class="w-full max-w-md aspect-square bg-white p-4 rounded-xl shadow-2xl border border-indigo/10 flex flex-col transform hover:-translate-y-2 transition-transform duration-500">
        <div class="w-full flex-grow rounded-lg overflow-hidden bg-paper relative">
          <div id="hero-carousel" class="flex w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)]">
            {heroCarouselImages.map((src, index) => (
              <div class="w-full h-full shrink-0 relative bg-paper">
                <img src={src} class={`w-full h-full object-cover opacity-90 ${index > 0 ? 'grayscale' : ''}`} alt={`Work ${index + 1}`} />
              </div>
            ))}
          </div>
        </div>
        <div class="pt-4 pb-2 flex justify-between items-center">
          <p class="text-[10px] font-bold uppercase tracking-widest text-indigo/60">Featured Project</p>
          <div class="w-2 h-2 bg-indigo"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Full Width -->
  <section class="w-full bg-paper/50 border-b border-indigo/10 py-12 overflow-hidden relative flex flex-col items-center reveal-on-scroll">
    <!-- Section Title -->
    <div class="w-full max-w-6xl px-6 md:px-12 mb-8 flex justify-center md:justify-start">
      <h3 class="text-xs md:text-sm font-bold uppercase tracking-widest text-indigo/50 flex items-center gap-3">
        <span class="w-4 h-px bg-indigo/30"></span>
        Our Clients
        <span class="w-4 h-px bg-indigo/30"></span>
      </h3>
    </div>

    <!-- Gradient Fades -->
    <div class="absolute top-0 left-0 w-32 h-full bg-gradient-to-r from-paper/50 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-32 h-full bg-gradient-to-l from-paper/50 to-transparent z-10 pointer-events-none"></div>
    
    <div class="overflow-hidden whitespace-nowrap relative w-full flex items-center group">
      <div class="animate-[marquee_25s_linear_infinite] flex items-center shrink-0 group-hover:[animation-play-state:paused]">
        <!-- Logos repeated -->
        {clientLogos.map((src) => (
          <div class="px-12 flex items-center justify-center">
            <img src={src} class="h-8 w-auto opacity-40 hover:opacity-100 transition-opacity mix-blend-multiply grayscale hover:grayscale-0" alt="Client Logo" />
          </div>
        ))}
      </div>
      <div class="animate-[marquee_25s_linear_infinite] flex items-center shrink-0 group-hover:[animation-play-state:paused]" aria-hidden="true">
        {clientLogos.map((src) => (
          <div class="px-12 flex items-center justify-center">
            <img src={src} class="h-8 w-auto opacity-40 hover:opacity-100 transition-opacity mix-blend-multiply grayscale hover:grayscale-0" alt="Client Logo" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About & Manifesto Split -->
  <section class="w-full flex flex-col lg:flex-row items-stretch border-b border-indigo/10">
    <!-- Left: Manifesto -->
    <div class="w-full lg:w-1/2 p-8 md:p-16 lg:p-24 bg-indigo text-paper flex flex-col justify-center reveal-on-scroll">
      <div class="w-4 h-4 bg-vermilion mb-10"></div>
      <h2 class="text-2xl md:text-4xl font-bold leading-tight tracking-tight mb-8">
        "{homepageData?.manifestoQuote || 'Design is not merely aesthetic decoration. It is the structural foundation upon which visionary brands are built.'}"
      </h2>
      <p class="text-xs font-bold uppercase tracking-widest text-gold">— {brandName}</p>
    </div>
    
    <!-- Right: Impact Numbers -->
    <div class="w-full lg:w-1/2 p-8 md:p-16 lg:p-24 bg-paper flex flex-col justify-center border-l lg:border-indigo/10 reveal-on-scroll delay-100">
      <h3 class="text-sm font-bold uppercase tracking-widest text-indigo/50 mb-12 border-b border-indigo/10 pb-4">Our Impact</h3>
      <div class="grid grid-cols-2 gap-y-12 gap-x-8">
        {impactStats.map((stat, index) => {
          const colors = ['text-vermilion', 'text-gold', 'text-indigo', 'text-indigo'];
          const color = colors[index % colors.length];
          return (
            <div class={`reveal-on-scroll delay-${index * 100}`}>
              <p class={`text-5xl md:text-6xl font-black ${color} tracking-tighter mb-2`}>{stat.number}</p>
              <p class="text-xs font-bold uppercase tracking-widest text-indigo">{stat.label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- NEW SECTION: Services Expertise -->
  <section class="w-full py-24 px-6 md:px-12 bg-paper border-b border-indigo/10">
    <div class="w-full max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 reveal-on-scroll">
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter">Core Expertise</h2>
        <a href="/services" class="text-sm font-bold uppercase tracking-widest text-indigo hover:text-vermilion transition-colors mt-4 md:mt-0 border-b border-indigo hover:border-vermilion pb-1">
          View All Services
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {serviceList.slice(0,3).map((service, index) => {
          const hoverColors = ['group-hover:text-gold', 'group-hover:text-vermilion', 'group-hover:text-gold'];
          const hoverColor = hoverColors[index % hoverColors.length];
          return (
            <div class={`group border border-indigo/10 p-8 hover:bg-indigo hover:text-paper transition-colors duration-500 reveal-on-scroll delay-${index * 100}`}>
               <div class="w-8 h-8 rounded-full border border-indigo flex items-center justify-center text-xs font-bold mb-16 group-hover:border-paper group-hover:text-paper">{service.id}</div>
               <h3 class={`text-2xl font-black uppercase tracking-tight mb-4 ${hoverColor}`}>{service.title}</h3>
               <p class="text-sm font-medium opacity-80 leading-relaxed">
                 {service.description}
               </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Large Visual Section -->
  <section class="w-full py-24 px-6 md:px-12 flex items-center justify-center bg-paper">
    <div class="w-full max-w-6xl flex flex-col lg:flex-row items-center gap-12 lg:gap-24">
      <div class="w-full lg:w-1/2 reveal-on-scroll">
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter mb-6">The Form of <br/> Things to Come</h2>
        <p class="text-base md:text-lg opacity-80 mb-8 leading-relaxed max-w-md">
          Every line, color, and grid we deploy is calculated to communicate authority and elegance. We strip away the unnecessary to reveal the essential structure of your brand.
        </p>
        <a href="/profile" class="inline-block border-b-2 border-vermilion pb-1 text-sm font-bold uppercase tracking-widest hover:text-vermilion transition-colors">
          Read Our Story
        </a>
      </div>
      <div class="w-full lg:w-1/2 relative reveal-on-scroll delay-200 flex justify-center">
        <!-- Accent Shadow/Frame behind it -->
        <div class="absolute -inset-2 md:-inset-4 bg-indigo/5 translate-x-4 translate-y-4 -z-10 rounded"></div>
        <div class="w-full max-w-md bg-white p-3 shadow-2xl border border-indigo/10 rounded-sm">
          <img src={homepageData?.faceImage || "/assets/ara_face.jpg"} alt="Geometric Face Illustration" class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- NEW SECTION: CTA -->
  <section class="w-full py-32 bg-indigo text-paper flex flex-col items-center justify-center text-center reveal-on-scroll border-t border-paper/10">
    <div class="w-6 h-6 bg-gold rounded-full mb-8 reveal-on-scroll delay-100"></div>
    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-8 reveal-on-scroll delay-200">{ctaTitle}</h2>
    <a href="/contact" class="px-10 py-5 bg-vermilion text-paper text-sm font-bold uppercase tracking-widest hover:bg-gold hover:text-indigo transition-colors shadow-xl reveal-on-scroll delay-300">
      {ctaButtonText}
    </a>
  </section>

  <!-- Scripts -->
  <script>
    // Carousel script
    const carousel = document.getElementById('hero-carousel');
    if (carousel) {
      let currentIndex = 0;
      const slides = carousel.children;
      const totalSlides = slides.length;
      setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
      }, 2500);
    }
  </script>
</BlankLayout>
