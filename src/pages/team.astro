---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const teamData = await reader.collections.team.all();

// Fallback data if collection is empty
const team = teamData.length > 0 ? teamData.map(t => ({
  name: t.entry.name,
  role: t.entry.role,
  photo: t.entry.photo
})) : [
  { name: 'Jane Doe', role: 'Design Director', photo: null },
  { name: 'John Smith', role: 'Technical Lead', photo: null },
  { name: 'Alice Johnson', role: 'Strategy & Ops', photo: null }
];
---

<Layout title="Team">
  
  <div class="flex items-stretch border-b border-indigo/20 relative">
    <div class="w-1/4 shrink-0 border-r border-indigo/20 hidden md:block"></div>
    <div class="p-6 md:p-12 md:pl-12 w-full">
      <h2 class="text-4xl md:text-5xl font-bold uppercase text-indigo mb-2">The Team</h2>
      <p class="text-lg font-medium">Architects of Vision</p>
    </div>
  </div>

  <section class="flex items-stretch flex-grow">
    <div class="w-1/4 shrink-0 border-r border-indigo/20"></div>
    <div class="w-full flex flex-col">
      {team.map((member, index) => {
        const bgColors = ['bg-indigo text-paper group-hover:bg-vermilion', 'bg-paper border-r border-indigo/20 group-hover:bg-gold', 'bg-vermilion text-paper group-hover:bg-indigo'];
        const textColors = ['text-paper', 'text-indigo', 'text-paper'];
        const numColor = textColors[index % textColors.length];
        const bgColor = bgColors[index % bgColors.length];
        const borderClass = index !== team.length - 1 ? 'border-b border-indigo/20' : '';
        const num = String(index + 1).padStart(2, '0');
        
        return (
          <div class={`flex flex-col sm:flex-row ${borderClass} group`}>
            <div class={`w-full sm:w-1/3 p-6 flex items-center justify-center transition-colors duration-300 ${bgColor} relative overflow-hidden`}>
               {member.photo ? (
                 <img src={member.photo} alt={member.name} class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-multiply group-hover:opacity-100 group-hover:mix-blend-normal transition-all duration-500 grayscale group-hover:grayscale-0" />
               ) : null}
               <span class={`text-6xl font-bold tracking-tighter relative z-10 ${numColor}`}>{num}</span>
            </div>
            <div class="p-6 sm:p-8 flex flex-col justify-center bg-white z-10 w-full">
               <h3 class="text-2xl font-bold uppercase mb-1">{member.name}</h3>
               <p class="text-sm font-semibold tracking-widest uppercase opacity-70">{member.role}</p>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <Fragment slot="right">
    <div class="relative w-full h-full flex flex-col items-center justify-center p-8">
       <!-- Abstract group illustration -->
       <div class="flex gap-4">
         <div class="w-24 h-48 bg-indigo hover:-translate-y-4 transition-transform duration-500"></div>
         <div class="w-24 h-64 bg-vermilion hover:-translate-y-4 transition-transform duration-500 delay-75"></div>
         <div class="w-24 h-32 bg-gold hover:-translate-y-4 transition-transform duration-500 delay-150"></div>
       </div>
    </div>
  </Fragment>

</Layout>
